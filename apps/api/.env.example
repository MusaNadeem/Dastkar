# apps/api/.env  — copy to apps/api/.env and fill in. Never commit real secrets.
# The API reads THIS file (dotenv loads .env from the api working directory).

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

PORT=4000
NODE_ENV=development

# Testing aid: lets the API accept an `x-dev-user-id` header instead of a real
# Google JWT, so you can exercise the backend before OAuth is set up.
# NEVER set this in production. Leave empty/false to require real auth.
ALLOW_DEV_AUTH=true
