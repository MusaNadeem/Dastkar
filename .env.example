# ─────────────────────────────────────────────
# Arts & Crafts Marketplace — environment template
# Copy to .env and fill in. NEVER commit real secrets.
# ─────────────────────────────────────────────

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Backend
PORT=4000
NODE_ENV=development

# Frontend (Vite requires the VITE_ prefix to expose vars to the client)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_API_BASE_URL=http://localhost:4000

# Email (placeholder — stub with console.log in dev)
EMAIL_PROVIDER_API_KEY=
